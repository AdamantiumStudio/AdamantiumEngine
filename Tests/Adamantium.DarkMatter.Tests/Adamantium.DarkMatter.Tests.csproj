<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>

        <IsPackable>false</IsPackable>

        <Platforms>AnyCPU</Platforms>

        <Configurations>Debug;Release</Configurations>

        <LangVersion>latest</LangVersion>

        <!-- Optimized from the first call: tests that count the bytes allocated must not catch the JIT moving a method
             to a higher tier, which on a slow runner can fall inside what they measure. -->
        <TieredCompilation>false</TieredCompilation>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit" Version="3.13.2" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Adamantium.DarkMatter\Adamantium.DarkMatter.csproj" />
    </ItemGroup>

</Project>
