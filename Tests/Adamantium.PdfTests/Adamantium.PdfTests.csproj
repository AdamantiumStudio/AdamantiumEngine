<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit" Version="3.13.2" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Adamantium.Pdf\Adamantium.Pdf.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Adamantium.FontTests\TTFFonts\SourceSans3-Bold.ttf" Link="Fonts\SourceSans3-Bold.ttf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Adamantium.FontTests\OTFFonts\SourceSans3-Regular.otf" Link="Fonts\SourceSans3-Regular.otf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\TestAssets\Jpeg2000\rgba-lossless.jp2" Link="Jpeg2000\rgba-lossless.jp2">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\TestAssets\Jpeg2000\rgba-lossless.rgba8" Link="Jpeg2000\rgba-lossless.rgba8">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- The JBIG2 writer of the imaging tests makes the JBIG2 the image tests embed. -->
    <ItemGroup>
        <Compile Include="..\Adamantium.ImagingTests\MqEncoder.cs" Link="Jbig2\MqEncoder.cs" />
        <Compile Include="..\Adamantium.ImagingTests\Jbig2Writer.cs" Link="Jbig2\Jbig2Writer.cs" />
    </ItemGroup>

</Project>
