<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="EffectsData\UIEffect.fx" />
    <None Remove="EffectsData\ComputeSmoke.fx" />
    <None Remove="EffectsData\StrokeExpand.fx" />
    <None Remove="EffectsData\StrokeDraw.fx" />
    <None Remove="EffectsData\AtomicAppend.fx" />
    <None Remove="EffectsData\IndirectDraw.fx" />
    <None Remove="EffectsData\DashCut.fx" />
    <None Remove="EffectsData\FontEffect.fx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="EffectsData\UIEffect.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Test-only effect fixtures (compute smoke + the GPU stroke expander/draw). They live here, NOT in the working
         Adamantium.FX project, so the engine isn't cluttered with test shaders and the generator doesn't emit phantom
         duplicate classes. Compiled at runtime via Effect.CompileFromFile from EffectsData. -->
    <Content Include="EffectsData\ComputeSmoke.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="EffectsData\StrokeExpand.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="EffectsData\StrokeDraw.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="EffectsData\AtomicAppend.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="EffectsData\IndirectDraw.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="EffectsData\DashCut.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- EffectLoadingTest compiles this one; it was the only fixture here without a copy rule, so it never reached the
         output and the test failed with FileNotFoundException rather than anything to do with effects. -->
    <Content Include="EffectsData\FontEffect.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The engine's own Forward+ effect, linked rather than copied, so the cluster tests run the shader the scene uses. -->
    <Content Include="..\..\Adamantium.FX\ForwardPlusEffect.fx" Link="EffectsData\ForwardPlusEffect.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Adamantium.FX\ForwardPlusWireEffect.fx" Link="EffectsData\ForwardPlusWireEffect.fx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Adamantium.FX\Includes\ForwardPlusShading.fxh" Link="EffectsData\Includes\ForwardPlusShading.fxh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Adamantium.FX\Includes\SkinnedVertex.fxh" Link="EffectsData\Includes\SkinnedVertex.fxh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Adamantium.FX\Includes\Skinning.fxh" Link="EffectsData\Includes\Skinning.fxh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Adamantium.FontTests\TTFFonts\SourceSans3-Regular.ttf" Link="Fonts\SourceSans3-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Adamantium.FontTests\TTFFonts\SourceSans3-Bold.ttf" Link="Fonts\SourceSans3-Bold.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Adamantium.FontTests\ColorFonts\test_glyphs-glyf_colr_1.ttf" Link="Fonts\test_glyphs-glyf_colr_1.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Adamantium.FontTests\ColorFonts\NotoColorEmoji.subset.ttf" Link="Fonts\NotoColorEmoji.subset.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Adamantium.FontTests\ColorFonts\chromacheck-colr.ttf" Link="Fonts\chromacheck-colr.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Adamantium.FontTests\Variations\RobotoFlex-Variable.ttf" Link="Fonts\RobotoFlex-Variable.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="NUnit" Version="3.13.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Adamantium.Graphics.Core\Adamantium.Graphics.Core.csproj" />
    <ProjectReference Include="..\..\Adamantium.Graphics\Adamantium.Graphics.csproj" />
    <ProjectReference Include="..\..\Adamantium.Imaging\Adamantium.Imaging.csproj" />
  </ItemGroup>

</Project>
