<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <IsPackable>false</IsPackable>

        <Platforms>AnyCPU</Platforms>

        <Configurations>Debug;Release</Configurations>

        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <!-- Copied under a name of OUR OWN. Every test project in this solution builds into the same output folder, and this
         project and Adamantium.Engine.GraphicsTests both shipped a DIFFERENT EffectsData\UIEffect.fx to it - so which
         shader these tests compiled depended on which project built last. That is what made this fixture pass or fail by
         build order rather than by anything about the compiler. -->
    <ItemGroup>
      <Content Include="EffectsData\UIEffect.fx">
        <Link>CompilerEffects\UIEffect.fx</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="nunit" Version="3.13.2" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Adamantium.Engine.Compiler\Adamantium.Engine.Compiler.csproj" />
      <ProjectReference Include="..\..\Adamantium.EffectsCompiler\Adamantium.EffectsCompiler.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="EffectsData\BasicEffect.fx">
        <Link>CompilerEffects\BasicEffect.fx</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Content Include="EffectsData\structs.fxh">
        <Link>CompilerEffects\structs.fxh</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Content Include="GltfData\**">
        <Link>CompilerGltf\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Content Include="EffectsData\structs.ui.fxh">
        <Link>CompilerEffects\structs.ui.fxh</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
