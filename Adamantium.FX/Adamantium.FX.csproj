<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>AnyCPU</Platforms>
        <Nullable>disable</Nullable>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
        <LangVersion>latest</LangVersion>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <Description>Built-in effects of the Adamantium engine - basic, font, sprite, Forward+ lighting, screenshot and full-screen quad - compiled into the assembly at build time.</Description>
        <PackageTags>adamantium;engine;shader;effects</PackageTags>
    </PropertyGroup>

    <!-- The Slang runtime rides in this package, so the shader compiler does not need the Vulkan SDK installed. Named
         here only to learn where NuGet put it; the generator is handed the path. -->
    <ItemGroup>
        <PackageReference Include="Adamantium.Vulkan.Slang" Version="1.1.0" GeneratePathProperty="true" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <AdamantiumSlangPath>$(PKGAdamantium_Vulkan_Slang)</AdamantiumSlangPath>
        <!-- Debug builds carry each effect's source path, so a running app can recompile it when it changes. -->
        <AdamantiumShaderHotReload Condition="'$(AdamantiumShaderHotReload)' == '' And '$(Configuration)' == 'Debug'">true</AdamantiumShaderHotReload>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Adamantium.Core\Adamantium.Core.csproj" />
        <ProjectReference Include="..\Adamantium.Graphics.Core\Adamantium.Graphics.Core.csproj" />
        <ProjectReference Include="..\Adamantium.Mathematics\Adamantium.Mathematics.csproj" />
        <ProjectReference Include="..\Adamantium.EffectsCompiler\Adamantium.EffectsCompiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
        <ProjectReference Include="..\Adamantium.Engine.Generators\Adamantium.Engine.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <!-- The source generators above are Roslyn analyzers; they need Core.Shared as an analyzer assembly too.
             Analyzer-ONLY: the assembly itself comes through Core above. -->
        <ProjectReference Include="..\Adamantium.Core.Shared\Adamantium.Core.Shared.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(ProjectDir)**\*.fx" />
        <AdditionalFiles Include="$(ProjectDir)**\*.fxh" />
        <CompilerVisibleProperty Include="RootNamespace" />
        <!-- The generator places each effect's class by the folder its .fx sits in, and needs the project root. -->
        <CompilerVisibleProperty Include="ProjectDir" />
        <!-- Where the Slang runtime is, so shaders build without the Vulkan SDK installed. -->
        <CompilerVisibleProperty Include="AdamantiumSlangPath" />
        <CompilerVisibleProperty Include="AdamantiumShaderHotReload" />
        <AdditionalFiles Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="obj\**" />
    </ItemGroup>

</Project>
