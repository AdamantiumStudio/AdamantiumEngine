<Project>

  <!-- A build for no platform copies the files of its packages for every system (runtimes/<rid>): built here, an app or
       test runs on this machine's system, so the other systems' are not copied - each architecture of this one, unix
       and any still are, laid out the same. Publishing and packing take them all, as they did. -->
  <Target Name="LeaveOutOtherSystemsPackageFiles" AfterTargets="ResolveLockFileCopyLocalFiles"
          Condition="'$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <_ThisSystem>$(NETCoreSdkPortableRuntimeIdentifier.Split('-')[0])</_ThisSystem>
    </PropertyGroup>
    <ItemGroup>
      <_OtherSystemsPackageFile Include="@(ReferenceCopyLocalPaths)"
                                Condition="'%(ReferenceCopyLocalPaths.RuntimeIdentifier)' != '' And
                                           '%(ReferenceCopyLocalPaths.RuntimeIdentifier)' != 'any' And
                                           !$([System.String]::Copy('%(ReferenceCopyLocalPaths.RuntimeIdentifier)').StartsWith('$(_ThisSystem)')) And
                                           ('$(_ThisSystem)' == 'win' Or
                                            !$([System.String]::Copy('%(ReferenceCopyLocalPaths.RuntimeIdentifier)').StartsWith('unix')))" />
      <ReferenceCopyLocalPaths Remove="@(_OtherSystemsPackageFile)" />
    </ItemGroup>
  </Target>

  <!-- The source generators read .auml/.fx through AdditionalFiles, which MSBuild's CoreCompile and Visual Studio's fast
       up-to-date check do not count as inputs: editing a view left the build "up to date" and the app ran the previously
       generated code. Added inside targets, not as project items, so an IDE does not list every such file again under
       each extra item type. -->
  <Target Name="AdditionalFilesAreCompileInputs" BeforeTargets="CoreCompile">
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="@(AdditionalFiles)" />
    </ItemGroup>
  </Target>

  <!-- A project names each AdamantiumVulkan assembly it needs once, as an AdamantiumVulkanReference, and here it becomes
       a reference to that project when the source is beside this repository, or to its package of
       AdamantiumVulkanVersion when it is not (see Directory.Build.props). -->
  <ItemGroup Condition="'$(UseVulkanSource)' == 'true'">
    <ProjectReference Include="@(AdamantiumVulkanReference->'$(AdamantiumVulkanDir)%(Identity)\%(Identity).csproj')" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseVulkanSource)' != 'true'">
    <PackageReference Include="@(AdamantiumVulkanReference)" Version="$(AdamantiumVulkanVersion)" />
  </ItemGroup>

  <!-- QuantumBinding.Utils the same way, named once as a QuantumBindingUtilsReference. -->
  <ItemGroup Condition="'$(UseQuantumBindingSource)' == 'true'">
    <ProjectReference Include="@(QuantumBindingUtilsReference->'$(QuantumBindingDir)%(Identity)\%(Identity).csproj')" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseQuantumBindingSource)' != 'true'">
    <PackageReference Include="@(QuantumBindingUtilsReference)" Version="$(QuantumBindingUtilsVersion)" />
  </ItemGroup>

  <Target Name="AdditionalFilesAreUpToDateInputs" BeforeTargets="CollectUpToDateCheckInputDesignTime">
    <ItemGroup>
      <UpToDateCheckInput Include="@(AdditionalFiles)" />
    </ItemGroup>
  </Target>

</Project>
