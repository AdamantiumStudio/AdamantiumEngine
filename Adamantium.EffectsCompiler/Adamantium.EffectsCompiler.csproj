<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Platforms>AnyCPU</Platforms>
        <IsPackable>true</IsPackable>
        <Description>Compiles Adamantium effects (.fx) to SPIR-V with the Slang compiler, along with the reflection data the engine binds them by.</Description>
        <PackageTags>adamantium;shader;effects;slang;spirv</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Adamantium.Vulkan.Spirv" Version="2.0.0" />
      <PackageReference Include="Adamantium.Vulkan.Slang" Version="1.1.0" />
      <PackageReference Include="MessagePack" Version="3.1.12" />
      <PackageReference Include="MessagePack.Annotations" Version="3.1.12" />
      <PackageReference Include="QuantumBinding.Utils" Version="3.0.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Adamantium.Core\Adamantium.Core.csproj" />
    </ItemGroup>

</Project>
