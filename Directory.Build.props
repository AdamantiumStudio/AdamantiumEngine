<Project>

  <PropertyGroup>
    <!-- Single top-level artifacts/ root next to the solution.
         bin is grouped BY TARGET FRAMEWORK: artifacts\bin\<Configuration>\<TargetFramework>\
         - all projects of the same TFM land together (so net8.0 and net10.0 assemblies never mix in
           one folder, which avoids System.Runtime version conflicts);
         - each TFM folder is self-contained, so the executable + its deps are in one predictable place.
         The TFM segment is appended by the SDK (AppendTargetFrameworkToOutputPath) - do NOT bake
         $(TargetFramework) into OutputPath here, it is still empty when Directory.Build.props runs.
         obj is per-project under artifacts\obj\<Project>\; NuGet packages go to artifacts\packages\. -->
    <OutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages\</PackageOutputPath>
    <!-- Built from a solution that does not list them (the UI's), our projects would pass no configuration on to
         each other and land in artifacts\bin\<tfm>. Ours list everything, so for them this changes nothing. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <!-- One identity for every assembly and package of the engine, the same as in QuantumBinding and AdamantiumVulkan. -->
  <PropertyGroup>
    <Authors>Adamantium Studio</Authors>
    <Company>Adamantium Studio</Company>
    <Copyright>Copyright © 2019-2026 Adamantium Studio</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AdamantiumStudio/AdamantiumEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamantiumStudio/AdamantiumEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- One version for every package of the engine: they are built together and move together, so the number alone says
       which ones work with each other. The only place it is set: a release changes it here, in the change it ships
       with, and the publish workflow packs what it says. An empty suffix is a stable release. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.5</VersionSuffix>
  </PropertyGroup>

  <!-- Off by default, on per project, as in AdamantiumVulkan: tests, sandboxes and tools are not products, and a
       published version can be unlisted but never deleted. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Each package carries its own icon.png from beside its csproj. The icons are generated with the studio's brand
       assets and copied here by their deploy script; both halves are guarded on the file, because PackageIcon naming
       a file that is not packed breaks the pack (NU5046). -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\icon.png')">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\icon.png')">
    <None Include="$(MSBuildProjectDirectory)\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
