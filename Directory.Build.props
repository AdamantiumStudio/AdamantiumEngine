<Project>

  <PropertyGroup>
    <!-- Single top-level artifacts/ root next to the solution.
         bin is grouped BY TARGET FRAMEWORK: artifacts\bin\<Configuration>\<TargetFramework>\
         - all projects of the same TFM land together (so net8.0 and net10.0 assemblies never mix in
           one folder, which avoids System.Runtime version conflicts);
         - each TFM folder is self-contained, so the executable + its deps are in one predictable place.
         The TFM segment is appended by the SDK (AppendTargetFrameworkToOutputPath) - do NOT bake
         $(TargetFramework) into OutputPath here, it is still empty when Directory.Build.props runs.
         obj is per-project under artifacts\obj\<Project>\; NuGet packages go to artifacts\packages\. -->
    <OutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages\</PackageOutputPath>
    <!-- Built from a solution that does not list them (the UI's), our projects would pass no configuration on to
         each other and land in artifacts\bin\<tfm>. Ours list everything, so for them this changes nothing. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <!-- The XML comments go out beside each assembly and into its package: an IDE shows them to whoever uses the engine,
       and the site builds its API reference from them. Not for the tests and the sandboxes, which are not products; not
       copied by a publish. A public member without one is no warning. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.Contains('Test')) and !$(MSBuildProjectName.Contains('Sandbox')) and !$(MSBuildProjectName.Contains('Oracle')) and !$(MSBuildProjectName.Contains('Generator'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Comments that do not read as XML documentation yet - a cref that resolves to nothing or to several members, a
         malformed tag, a parameter left out: warned of, not failing the build, and mended as the types they document
         get their pages. -->
    <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);CS0419;CS1570;CS1572;CS1573;CS1574;CS1734</MSBuildWarningsNotAsErrors>
  </PropertyGroup>

  <!-- One identity for every assembly and package of the engine, the same as in QuantumBinding and AdamantiumVulkan. -->
  <PropertyGroup>
    <Authors>Adamantium Studio</Authors>
    <Company>Adamantium Studio</Company>
    <Copyright>Copyright © 2019-2026 Adamantium Studio</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AdamantiumStudio/AdamantiumEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AdamantiumStudio/AdamantiumEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- One version for every package of the engine: they are built together and move together, so the number alone says
       which ones work with each other. The only place it is set: a release changes it here, in the change it ships
       with, and the publish workflow packs what it says. An empty suffix is a stable release. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.5</VersionSuffix>
  </PropertyGroup>

  <!-- Off by default, on per project, as in AdamantiumVulkan: tests, sandboxes and tools are not products, and a
       published version can be unlisted but never deleted. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Each package carries its own icon.png from beside its csproj. The icons are generated with the studio's brand
       assets and copied here by their deploy script; both halves are guarded on the file, because PackageIcon naming
       a file that is not packed breaks the pack (NU5046). -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\icon.png')">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\icon.png')">
    <None Include="$(MSBuildProjectDirectory)\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The Vulkan bindings from AdamantiumVulkan's source when it is checked out beside this repository, so a binding
       change is used before its package is published; from the package of this version when it is not - a clone of
       this repository alone, a release. -p:UseVulkanSource=false takes the package even with the source beside. -->
  <PropertyGroup>
    <AdamantiumVulkanDir>$(MSBuildThisFileDirectory)..\AdamantiumVulkan\</AdamantiumVulkanDir>
    <UseVulkanSource Condition="'$(UseVulkanSource)' == ''">$([System.IO.Directory]::Exists('$(AdamantiumVulkanDir)'))</UseVulkanSource>
    <AdamantiumVulkanVersion>1.4.1</AdamantiumVulkanVersion>
  </PropertyGroup>

  <!-- QuantumBinding - the generator and the Utils the bindings call - the same way: its source when beside, else
       these packages. -p:UseQuantumBindingSource=false takes the packages even with the source beside. -->
  <PropertyGroup>
    <QuantumBindingDir>$(MSBuildThisFileDirectory)..\QuantumBinding\</QuantumBindingDir>
    <UseQuantumBindingSource Condition="'$(UseQuantumBindingSource)' == ''">$([System.IO.Directory]::Exists('$(QuantumBindingDir)'))</UseQuantumBindingSource>
    <QuantumBindingVersion>3.4.0</QuantumBindingVersion>
    <QuantumBindingUtilsVersion>3.2.0</QuantumBindingUtilsVersion>
  </PropertyGroup>

</Project>
