<Project Sdk="Microsoft.NET.Sdk">

    <!-- netstandard2.0: the generators and the language server load it to read language files (LanguageFileParser) and
         know a language's plural forms, and tell their messages through MessageCatalog; the running application uses the
         same assembly. -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>true</IsPackable>
        <Description>Localization of Adamantium: string tables generated from .alang language files, the application's language, plural rules and the messages of tools - for the engine, games and the UI alike.</Description>
        <PackageTags>adamantium;localization;language;plural</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization\*.alang" LogicalName="Localization/%(Filename)%(Extension)" WithCulture="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Adamantium.Core.Shared\Adamantium.Core.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Adamantium.Localization.Generators" />
        <InternalsVisibleTo Include="Adamantium.LocalizationTests" />
    </ItemGroup>

</Project>
