<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <Description>MVVM for Adamantium: view models with validation, sync and async commands, and the attributes its source generator reads.</Description>
        <PackageTags>adamantium;mvvm;viewmodel;commands</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <!-- PropertyChangedBase (INPC base) + ICommand (the generated commands implement it) both live in Core, so this
             library is UI-free and safe to reference from any layer (e.g. Adamantium.ECS.Components). -->
        <ProjectReference Include="..\Adamantium.Core\Adamantium.Core.csproj" />
        <ProjectReference Include="..\Adamantium.MVVM.Generators\Adamantium.MVVM.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- So a test can tell a generated accessor from a reflected one. -->
        <InternalsVisibleTo Include="Adamantium.MVVM.Tests" />
        <InternalsVisibleTo Include="Adamantium.UITests" />
    </ItemGroup>

</Project>
