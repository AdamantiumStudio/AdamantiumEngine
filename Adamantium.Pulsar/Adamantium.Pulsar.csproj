<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>net11.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <Description>Pulsar, the audio engine of Adamantium: output to the system's audio devices. Stands on its own - no entities, no window, no GPU.</Description>
    <PackageTags>adamantium;engine;audio;sound</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adamantium.MacOS\Adamantium.MacOS.csproj" />
    <ProjectReference Include="..\Adamantium.Win32\Adamantium.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Adamantium.Pulsar.Tests" />
  </ItemGroup>

</Project>
