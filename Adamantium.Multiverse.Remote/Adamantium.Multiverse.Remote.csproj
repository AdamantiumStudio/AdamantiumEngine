<Project Sdk="Microsoft.NET.Sdk">

	<!-- A universe shown in another process: the service a universe host serves and its viewer calls, over pipes, in
	     MessagePack, on threads of the link's own. Apart from Adamantium.Multiverse, so what uses a universe in its own
	     process takes none of it. -->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Platforms>AnyCPU</Platforms>
		<Configurations>Debug;Release</Configurations>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPackable>true</IsPackable>
		<Description>A universe of the Adamantium engine shown in another process: the host's service, its viewer's callbacks and the connection between them.</Description>
		<PackageTags>adamantium;engine;remote;rpc</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Adamantium.Multiverse\Adamantium.Multiverse.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MessagePack" Version="3.1.12" />
	</ItemGroup>

</Project>
