<Project Sdk="Microsoft.NET.Sdk">

	<!-- A universe shown in another process: the service a universe host serves and its viewer calls, over a pipe, with
	     StreamJsonRpc. Apart from Adamantium.Multiverse, so what uses a universe in its own process takes none of it. -->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Platforms>AnyCPU</Platforms>
		<Configurations>Debug;Release</Configurations>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>true</IsPackable>
		<Description>A universe of the Adamantium engine shown in another process: the host's service, its viewer's callbacks and the connection between them.</Description>
		<PackageTags>adamantium;engine;remote;rpc</PackageTags>
		<!-- StreamJsonRpc0008 asks for PolyType shapes, which only the Nerdbank.MessagePack formatter reads; the
		     connection uses MessagePackFormatter, between processes of one desktop machine. -->
		<NoWarn>$(NoWarn);StreamJsonRpc0008</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Adamantium.Multiverse\Adamantium.Multiverse.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="StreamJsonRpc" Version="2.26.150" />
	</ItemGroup>

</Project>
