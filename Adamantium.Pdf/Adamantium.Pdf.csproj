<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latest</LangVersion>
        <IsPackable>true</IsPackable>
        <Description>Reads PDF files - objects, cross-reference tables and streams, damaged-file repair, stream filters, the standard security handler, the page tree, content streams, fonts, color spaces, functions and images.</Description>
        <PackageTags>adamantium;pdf;document</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Adamantium.Core\Adamantium.Core.csproj" />
        <ProjectReference Include="..\Adamantium.Fonts\Adamantium.Fonts.csproj" />
        <ProjectReference Include="..\Adamantium.Imaging\Adamantium.Imaging.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Adamantium.PdfTests" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Fonts\Data\CMaps\*" LogicalName="Adamantium.Pdf.CMaps.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Fonts\Data\GlyphList\*.txt" LogicalName="Adamantium.Pdf.GlyphList.%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Part of this package carries third-party data; the notices travel with it. -->
    <ItemGroup>
        <None Include="..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

</Project>
