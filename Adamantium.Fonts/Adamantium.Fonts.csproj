<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <LangVersion>latestmajor</LangVersion>
        <IsPackable>true</IsPackable>
        <Description>Reads TrueType, OpenType and CFF fonts - outlines, metrics, kerning and OpenType features - and generates multichannel signed distance field (MSDF) glyph atlases.</Description>
        <PackageTags>adamantium;fonts;opentype;truetype;cff;msdf</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="atomicage-regular.ttf" />
      <None Remove="azoft-sans.ttf" />
      <None Remove="PlayfairDisplay-Regular.ttf" />
      <None Remove="Windsong.ttf" />
      <None Remove="OTFFonts\Poppins-Medium.otf" />
      <None Remove="OTFFonts\Glametrix-oj9A.otf" />
      <None Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Adamantium.Core\Adamantium.Core.csproj" />
      <ProjectReference Include="..\Adamantium.Mathematics\Adamantium.Mathematics.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Adamantium.FontTests" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="obj\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="obj\**" />
      <EmbeddedResource Include="Data\*.ucd;Data\*.dat" />
      <EmbeddedResource Include="Data\Hyphenation\*.tex" LogicalName="Adamantium.Fonts.Data.Hyphenation.%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Part of this package is derived from third-party code and data; the notices travel with it. -->
    <ItemGroup>
      <None Include="..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
      <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

</Project>
