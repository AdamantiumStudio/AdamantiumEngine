<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes the engine's generated bindings into the libraries that carry them (Adamantium.Wayland,
       Adamantium.GameInput); nothing references it and it does not ship. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <!-- Its own folder: it carries libclang and its own runtime identifier, which the libraries' shared folder has no
         use for. -->
    <OutputPath>$(MSBuildThisFileDirectory)..\artifacts\bin\$(MSBuildProjectName)\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuantumBinding.Generator" Version="3.1.1" />
  </ItemGroup>

</Project>
