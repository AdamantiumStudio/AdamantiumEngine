<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Platforms>AnyCPU</Platforms>
		<Configurations>Debug;Release</Configurations>
		<LangVersion>latest</LangVersion>
		<IsPackable>true</IsPackable>
		<Description>Image codecs of the Adamantium engine - PNG and APNG, JPEG, GIF, BMP, TGA, TIFF, ICO, DDS - with mipmaps, format conversion and palette quantizers.</Description>
		<PackageTags>adamantium;imaging;png;jpeg;dds;codec</PackageTags>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<PlatformTarget>AnyCPU</PlatformTarget>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<PlatformTarget>AnyCPU</PlatformTarget>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Adamantium.Vulkan" Version="1.0.3" />
		<ProjectReference Include="..\Adamantium.Core\Adamantium.Core.csproj" />
		<ProjectReference Include="..\Adamantium.Mathematics\Adamantium.Mathematics.csproj" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Adamantium.ImagingTests" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Remove="obj\**" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Remove="obj\**" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="obj\**" />
	</ItemGroup>

	<!-- Part of this package is derived from third-party code; the notices travel with it. -->
	<ItemGroup>
	  <None Include="..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
	  <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
