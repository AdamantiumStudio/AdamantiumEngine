<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Platforms>AnyCPU</Platforms>
		<Configurations>Debug;Release</Configurations>
		<LangVersion>latest</LangVersion>
		<IsPackable>true</IsPackable>
		<Description>Entity-component system of the Adamantium engine: entities, components, cameras, colliders, animation and meshes.</Description>
		<PackageTags>adamantium;engine;ecs;entity;component</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Adamantium.Core\Adamantium.Core.csproj" />
		<ProjectReference Include="..\Adamantium.DarkMatter\Adamantium.DarkMatter.csproj" />
		<ProjectReference Include="..\Adamantium.Graphics.Core\Adamantium.Graphics.Core.csproj" />
		<ProjectReference Include="..\Adamantium.Graphics\Adamantium.Graphics.csproj" />
		<ProjectReference Include="..\Adamantium.Mathematics\Adamantium.Mathematics.csproj" />
		<ProjectReference Include="..\Adamantium.ProceduralGeometry\Adamantium.ProceduralGeometry.csproj" />
		<ProjectReference Include="..\Adamantium.Pulsar\Adamantium.Pulsar.csproj" />
		<!-- AdamantiumViewModel base (UI-free, Core-only) so Component is INPC/[Bindable]-ready + the MVVM generator. -->
		<ProjectReference Include="..\Adamantium.MVVM\Adamantium.MVVM.csproj" />
		<ProjectReference Include="..\Adamantium.MVVM.Generators\Adamantium.MVVM.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="Adamantium.EngineTests" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="11.0.0" />
	</ItemGroup>

</Project>
